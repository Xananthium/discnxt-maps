# Public, browser-readable, append-only epoch manifest. Keep this JSON on one
# line. Epoch IDs are immutable ISO capture dates: retain prior entries and
# append a new object for each future release. Every epoch owns its tileset URL
# and both gates. Any malformed entry fails the complete manifest closed to the
# built-in 2026-07-29 boundary-only baseline.
NEXT_PUBLIC_MAP_EPOCHS_JSON=[{"id":"2026-07-29","label":"Baseline","captureDate":"2026-07-29","releaseId":"preview-no-public-release","modelStatusLabel":"Awaiting reviewed public metric release.","metricTilesetUrl":"","publicReleaseApproved":false,"privacyCropVerified":false}]

NEXT_PUBLIC_BOUNDARY_URL=/cemetery-boundary.geojson

# CesiumJS 1.143, pinned to the official CDN. Mirror these licensed files and
# change all three values together if the public host requires self-hosting.
NEXT_PUBLIC_CESIUM_BASE_URL=https://cesium.com/downloads/cesiumjs/releases/1.143/Build/Cesium/
NEXT_PUBLIC_CESIUM_SCRIPT_URL=https://cesium.com/downloads/cesiumjs/releases/1.143/Build/Cesium/Cesium.js
NEXT_PUBLIC_CESIUM_WIDGETS_CSS_URL=https://cesium.com/downloads/cesiumjs/releases/1.143/Build/Cesium/Widgets/widgets.css
