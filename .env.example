# Public, browser-readable asset locations. Keep the metric URL empty until a
# reviewed, privacy-cropped, metric 3D Tiles release exists.
NEXT_PUBLIC_METRIC_TILESET_URL=
NEXT_PUBLIC_BOUNDARY_URL=/cemetery-boundary.geojson

# Both gates must be true before the viewer will request the metric tileset.
NEXT_PUBLIC_PUBLIC_RELEASE_APPROVED=false
NEXT_PUBLIC_PRIVACY_CROP_VERIFIED=false

NEXT_PUBLIC_RELEASE_ID=preview-no-public-release
NEXT_PUBLIC_MODEL_STATUS=Awaiting reviewed public metric release
NEXT_PUBLIC_CAPTURE_DATE=2026-07-29

# CesiumJS 1.143, pinned to the official CDN. Mirror these licensed files and
# change all three values together if the public host requires self-hosting.
NEXT_PUBLIC_CESIUM_BASE_URL=https://cesium.com/downloads/cesiumjs/releases/1.143/Build/Cesium/
NEXT_PUBLIC_CESIUM_SCRIPT_URL=https://cesium.com/downloads/cesiumjs/releases/1.143/Build/Cesium/Cesium.js
NEXT_PUBLIC_CESIUM_WIDGETS_CSS_URL=https://cesium.com/downloads/cesiumjs/releases/1.143/Build/Cesium/Widgets/widgets.css
