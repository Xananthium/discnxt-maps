[Unit]
Description=Discnxt cemetery metric-map viewer
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=discnxt-maps
Group=discnxt-maps
WorkingDirectory=/srv/discnxt-maps/releases/@COMMIT@
Environment=NODE_ENV=production
Environment=HOSTNAME=127.0.0.1
Environment=PORT=4310
EnvironmentFile=/etc/discnxt-maps/releases/@COMMIT@.env
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 4310
Restart=on-failure
RestartSec=2
TimeoutStopSec=20
KillSignal=SIGINT
UMask=0027
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
